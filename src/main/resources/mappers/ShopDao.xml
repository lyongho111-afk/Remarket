<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.remarket.dao.ShopDao">
    <resultMap id="dto" type="ShopDto">
        <id property="shopId" column="shopId"/>
        <result property="schoolId" column="school_id"/>
        <result property="version" column="version"/>
        <result property="ownerMemberId" column="owner_member_id"/>
        <result property="shopname" column="shopname"/>
        <result property="shopphone" column="shopphone"/>
        <result property="address" column="address"/>
        <result property="photo" column="photo"/>
        <result property="latitude" column="latitude"/>
        <result property="longitude" column="longitude"/>
        <result property="busino" column="busino"/>
        <result property="ceoname" column="ceoname"/>
        <result property="busiKind" column="busi_kind"/>
        <result property="bmenu" column="bmenu"/>
        <result property="reservtime" column="reservtime"/>
        <result property="busitime" column="busitime"/>
        <result property="offday" column="offday"/>
        <result property="specialevent" column="specialevent"/>
        <result property="sizeandtype" column="sizeandtype"/>
        <result property="status" column="status"/>
        <result property="availablespace" column="availablespace"/>
        <result property="checked" column="checked"/>
    </resultMap>
    <select id="selectAll" resultMap="dto">
        SELECT * FROM shops ORDER BY shopId DESC
    </select>
    <select id="selectOne" resultMap="dto">SELECT * FROM shops WHERE shopId=#{id}</select>
    <insert id="insert" parameterType="ShopDto" useGeneratedKeys="true" keyProperty="shopId">
        INSERT INTO shops (school_id,latitude,longitude,address,photo,owner_member_id,shopname,shopphone,busino,ceoname,busi_kind,bmenu,reservtime,busitime,offday,specialevent,sizeandtype,status,availablespace) VALUES (#{schoolId},#{latitude},#{longitude},#{address},#{photo},#{ownerMemberId},#{shopname},#{shopphone},#{busino},#{ceoname},#{busiKind},#{bmenu},#{reservtime},#{busitime},#{offday},#{specialevent},#{sizeandtype},#{status},#{availablespace})
    </insert>
    <update id="update" parameterType="ShopDto">
        UPDATE shops SET shopname=#{shopname}, shopphone=#{shopphone}, busino=#{busino}, ceoname=#{ceoname}, busi_kind=#{busiKind}, bmenu=#{bmenu}, reservtime=#{reservtime}, busitime=#{busitime}, offday=#{offday}, specialevent=#{specialevent}, sizeandtype=#{sizeandtype}, status=#{status}, availablespace=#{availablespace} WHERE shopId=#{shopId}
    </update>
    <delete id="delete">DELETE FROM shops WHERE shopId=#{id}</delete>
</mapper>
